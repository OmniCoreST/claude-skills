# PLACEHOLDERS — replace all of these before committing:
#   {{SITE_DOMAIN}}      example.com
#   {{PROJECT_NAME}}     the Cloudflare Pages project name, e.g. example
#   {{ACCOUNT_ID}}       Cloudflare account id (from `npx wrangler whoami`) — not secret
#   {{MARKER}}           a unique tag for the PR comment, e.g. example-preview
#   {{EXTRA_LINKS}}      one line of extra preview links, or delete the line entirely.
#                        Multi-language example:
#                          `English ${url} · Türkçe ${url}/tr\n\n` +
#
# Builds the site and deploys it to the existing Cloudflare Pages project.
#
#   push to main      -> production deploy ({{SITE_DOMAIN}})
#   pull request      -> preview deploy; the URL is posted as a PR comment
#
# Requires one repository secret: CLOUDFLARE_API_TOKEN
# (Cloudflare token with "Cloudflare Pages: Edit" permission on the account).

name: Deploy

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  # A superseded build is cancelled, so the preview URL always reflects the
  # newest commit rather than whichever build happened to finish last.
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write # to post the preview-URL comment
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
          cache-dependency-path: web/package-lock.json

      - name: Install dependencies
        run: npm ci
        working-directory: web

      - name: Build
        run: npm run build
        working-directory: web

      - name: Deploy to Cloudflare Pages
        id: deploy
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: {{ACCOUNT_ID}}
          workingDirectory: web
          # head_ref is empty on push events, so pushes to main land on the
          # production branch and pull requests get their own named preview.
          command: pages deploy dist --project-name={{PROJECT_NAME}} --branch=${{ github.head_ref || 'main' }}

      - name: Comment preview URL on the PR
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            // The alias URL stays the same across pushes to one pull request,
            // which is what lets the comment promise it keeps updating.
            const url =
              `${{ steps.deploy.outputs.pages-deployment-alias-url }}` ||
              `${{ steps.deploy.outputs.deployment-url }}`;
            const marker = "<!-- {{MARKER}} -->";
            const body = `${marker}\n### Preview is ready\n\n` +
              `Check this change on a private copy of the site: ${url}\n\n` +
              {{EXTRA_LINKS}}
              `_Updates automatically on every new commit to this pull request. ` +
              `The live site is untouched until the pull request is merged._`;
            // Update the existing comment rather than adding another, so a
            // long-running pull request doesn't accumulate a wall of them.
            const { data: comments } = await github.rest.issues.listComments({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
            });
            const existing = comments.find((c) => c.body?.includes(marker));
            if (existing) {
              await github.rest.issues.updateComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                comment_id: existing.id,
                body,
              });
            } else {
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.issue.number,
                body,
              });
            }
